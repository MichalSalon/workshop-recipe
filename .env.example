# API
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:5173
# On Zerops the API also admits any origin on the project's own subdomain
# host, so CORS follows the project into whatever region it runs in.
PROJECT_SUBDOMAIN_HOST=
API_URL=http://localhost:3000

# Bind these to Zerops service connection strings when the project exists.
# Local `npm run dev` runs without them (in-memory store + inline worker).
DATABASE_URL=
NATS_URL=
NATS_HOST=
NATS_PORT=
NATS_USER=
NATS_PASSWORD=
VALKEY_URL=

# Worker
WORKER_ID=
RENDER_DRIVER=stub
RENDER_SPIN_MS=400

